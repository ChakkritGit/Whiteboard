# Where the room server is. Leave unset for ws://localhost:1234, which is what
# `npm run dev:all` starts.
#
# In production this is either the Cloudflare Worker in ./worker …
#   NEXT_PUBLIC_WS_URL=wss://whiteboard-rooms.<subdomain>.workers.dev
# … or scripts/server.mjs running somewhere that keeps a process alive.
#   NEXT_PUBLIC_WS_URL=wss://rooms.example.com
#
# `wss://`, not `ws://`: an HTTPS page may not open an unencrypted socket, and
# the board will simply never connect if this is wrong.
NEXT_PUBLIC_WS_URL=ws://localhost:1234

# The canonical origin, used for the sitemap, robots.txt and the absolute URLs
# in link previews. Set it on preview deployments too, or a preview will name the
# production URL as its canonical and ask search engines to ignore itself.
NEXT_PUBLIC_SITE_URL=https://whiteboard.chakkritton.com
