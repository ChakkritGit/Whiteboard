# The room server only. The site is built and hosted separately; see the README.
FROM node:24-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --omit=dev
COPY scripts ./scripts
# The picture rules are shared with the app, and the server imports them.
COPY src/lib/image-rules.ts ./src/lib/image-rules.ts
ENV PORT=1234
EXPOSE 1234
CMD ["node", "scripts/server.mjs"]
